# Copy to .env.production. Never commit the real file.
# Use a URL-safe random value (hex) for the dedicated PostgreSQL password.
POSTGRES_PASSWORD=replace-with-random-hex
BOB_ORIGIN=https://bob.carrtech.dev
BOB_PORT=3080
# Generate using scripts/provision.py; key remains separate from the encrypted bundle.
BOB_KEY_FILE=/opt/bob/secrets/master.key
BOB_CREDENTIALS_FILE=/opt/bob/secrets/credentials.enc
BOB_PASSWORD_HASH=replace-with-provisioned-password-hash
# Administrator-selected provider. No provider or model is enabled by default.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Optional AI_MODEL_STRATEGY, AI_MODEL_CRITIC, AI_MODEL_INBOX, AI_MODEL_CORRESPONDENCE
# GBP per million tokens: configure from your actual provider pricing.
AI_INPUT_PRICE=0
AI_OUTPUT_PRICE=0
AI_CACHED_PRICE=0
PROJECT_BUDGET_GBP=10
